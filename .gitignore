__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/

# GCP credentials
*.json
!e2e_cases/**/*.json
!deploy/cloud_run_config.json
service-account*.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

